# ============================================
# Votify — Environment Variables Template
# ============================================
# Copy this file to .env and fill in your credentials.
# Supports MongoDB Atlas, Redis Cloud, and Aiven Kafka.
# NEVER commit .env to source control.
# ============================================

# ── General ──────────────────────────────────
APP_ENV=development
LOG_LEVEL=debug

# ── Frontend ─────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8084/ws

# ── API Gateway ──────────────────────────────
API_GATEWAY_PORT=8080
AUTH_SERVICE_URL=http://localhost:8081
POLL_SERVICE_URL=http://localhost:8082
VOTE_SERVICE_URL=http://localhost:8083
REALTIME_SERVICE_URL=http://localhost:8084
ANALYTICS_SERVICE_URL=http://localhost:8085
PAYMENT_SERVICE_URL=http://localhost:8086

# ── Auth Service ─────────────────────────────
AUTH_SERVICE_PORT=8081
AUTH_MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net
AUTH_MONGO_DB=auth_db
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRY=24h

# ── Poll Service ─────────────────────────────
POLL_SERVICE_PORT=8082
POLL_MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net
POLL_MONGO_DB=poll_db

# ── Vote Service ─────────────────────────────
VOTE_SERVICE_PORT=8083
VOTE_MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net
VOTE_MONGO_DB=vote_db

# ── Realtime Service ─────────────────────────
REALTIME_SERVICE_PORT=8084

# ── Analytics Service ────────────────────────
ANALYTICS_SERVICE_PORT=8085
ANALYTICS_MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net
ANALYTICS_MONGO_DB=analytics_db

# ── Payment Service ──────────────────────────
PAYMENT_SERVICE_PORT=8086
PAYMENT_MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net
PAYMENT_MONGO_DB=payment_db

# ── Redis (Redis Cloud / Upstash Redis) ─────
REDIS_ADDR=redis-12345.c1.us-east-1-1.ec2.cloud.redislabs.com:12345
REDIS_PASSWORD=your-redis-cloud-password
REDIS_DB=0

# ── Kafka (Aiven for Apache Kafka / Upstash) ──
KAFKA_BROKERS=kafka-12345-aivencloud.com:28938
KAFKA_GROUP_ID=votify-group
KAFKA_USER=avnadmin
KAFKA_PASSWORD=your-aiven-kafka-password

# ── MongoDB (Shared Cluster Fallback) ────────
MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net
